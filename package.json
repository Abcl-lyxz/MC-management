{
  "name": "mc-management",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot that runs a Minecraft server in Docker, configured entirely from Discord.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && lefthook install",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --import tsx src/index.ts",
    "check-fast": "biome ci . && tsc --noEmit",
    "check": "pnpm check-fast && vitest run && pnpm validate-status && secretlint \"**/*\"",
    "fix": "biome check --write .",
    "validate-status": "node scripts/validate-status.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dockerode": "5.0.1",
    "pino": "10.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/dockerode": "4.0.1",
    "@types/node": "24.19.0",
    "lefthook": "2.1.14",
    "secretlint": "13.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "lefthook",
      "protobufjs",
      "ssh2"
    ]
  }
}
